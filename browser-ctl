#!/bin/bash
# browser-ctl: CLI tool for controlling Agent Browser from the terminal.
# Reads connection info from ~/.config/agent-browser/connection.json.
#
# Usage:
#   browser-ctl tabs                         List all open tabs
#   browser-ctl get <tab-id>                 Get details for a tab
#   browser-ctl open <url>                   Open a URL in a new tab
#   browser-ctl read <tab-id>                Read page content from a tab
#   browser-ctl js <tab-id> <script>         Execute JavaScript in a tab
#   browser-ctl screenshot <tab-id> [file]   Capture screenshot (saves PNG)
#   browser-ctl health                       Check if browser is running

set -euo pipefail

CONFIG_FILE="$HOME/.config/agent-browser/connection.json"

# Read connection descriptor
if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: Agent Browser is not running (no connection descriptor at $CONFIG_FILE)" >&2
    exit 1
fi

BASE_URL=$(python3 -c "import json; print(json.load(open('$CONFIG_FILE'))['url'])")
TOKEN=$(python3 -c "import json; print(json.load(open('$CONFIG_FILE'))['token'])")

# Helper: make an authenticated curl request
api() {
    local method="$1"
    local path="$2"
    shift 2
    curl -s -X "$method" \
        -H "Authorization: Bearer $TOKEN" \
        -H "Content-Type: application/json" \
        -H "Host: 127.0.0.1:${BASE_URL##*:}" \
        "$@" \
        "${BASE_URL}${path}"
}

# Helper: make a request and pretty-print JSON
api_json() {
    api "$@" | python3 -m json.tool 2>/dev/null || api "$@"
}

# Commands
case "${1:-help}" in

    health)
        curl -s "${BASE_URL}/health" | python3 -m json.tool
        ;;

    tabs|list)
        api_json GET /api/tabs
        ;;

    get)
        if [ -z "${2:-}" ]; then
            echo "Usage: browser-ctl get <tab-id>" >&2
            exit 1
        fi
        api_json GET "/api/tabs/$2"
        ;;

    open)
        if [ -z "${2:-}" ]; then
            echo "Usage: browser-ctl open <url>" >&2
            exit 1
        fi
        api_json POST /api/tabs -d "{\"url\": \"$2\"}"
        ;;

    read)
        if [ -z "${2:-}" ]; then
            echo "Usage: browser-ctl read <tab-id>" >&2
            exit 1
        fi
        # Default: text only. Pass --html for HTML too.
        if [ "${3:-}" = "--html" ]; then
            api_json POST "/api/tabs/$2/read" -d '{"html": true}'
        else
            api_json GET "/api/tabs/$2/read"
        fi
        ;;

    js|eval)
        if [ -z "${2:-}" ] || [ -z "${3:-}" ]; then
            echo "Usage: browser-ctl js <tab-id> <script>" >&2
            echo "  Example: browser-ctl js <id> 'return document.title'" >&2
            exit 1
        fi
        # Escape the script for JSON
        ESCAPED_SCRIPT=$(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$3")
        api_json POST "/api/tabs/$2/js" -d "{\"script\": $ESCAPED_SCRIPT}"
        ;;

    screenshot)
        if [ -z "${2:-}" ]; then
            echo "Usage: browser-ctl screenshot <tab-id> [output.png]" >&2
            exit 1
        fi
        OUTPUT="${3:-screenshot.png}"
        api GET "/api/tabs/$2/screenshot" -o "$OUTPUT"
        echo "Screenshot saved to $OUTPUT"
        ;;

    help|--help|-h)
        cat <<EOF
browser-ctl: Control Agent Browser from the terminal.

Commands:
  health                          Check if browser is running
  tabs                            List all open tabs
  get <tab-id>                    Get details for a specific tab
  open <url>                      Open a URL in a new tab
  read <tab-id>                   Read page content (text) from a live tab
  read <tab-id> --html            Read page content including HTML
  js <tab-id> <script>            Execute JavaScript in a tab
  screenshot <tab-id> [file.png]  Capture tab screenshot

Tab IDs are UUIDs. Get them from 'browser-ctl tabs'.

The browser writes its connection info to:
  ~/.config/agent-browser/connection.json

Examples:
  browser-ctl tabs
  browser-ctl open https://github.com
  browser-ctl read 7A91B3F2-...
  browser-ctl js 7A91B3F2-... 'return document.title'
  browser-ctl screenshot 7A91B3F2-... page.png
EOF
        ;;

    *)
        echo "Unknown command: $1. Run 'browser-ctl help' for usage." >&2
        exit 1
        ;;
esac

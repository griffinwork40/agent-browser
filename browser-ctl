#!/bin/bash
# browser-ctl: Control a running Agent Browser from the terminal.
#
# Reads connection info from ~/.config/agent-browser/connection.json
# and communicates with the browser's local HTTP API.
#
# Usage:
#   browser-ctl tabs                             List open tabs
#   browser-ctl tab <id>                         Get tab details
#   browser-ctl open <url>                       Open URL in new tab
#   browser-ctl read <id> [--text|--html]        Read page content (default: markdown)
#   browser-ctl eval <id> <script>               Execute JavaScript
#   browser-ctl screenshot <id> [output.png]     Save screenshot
#   browser-ctl health                           Check browser status
#
# Tab IDs are UUIDs from 'browser-ctl tabs'. Closing a tab invalidates its ID.

set -euo pipefail

CONFIG="$HOME/.config/agent-browser/connection.json"

die() { echo "error: $1" >&2; exit 1; }

[ -f "$CONFIG" ] || die "Agent Browser not running (no $CONFIG)"

URL=$(python3 -c "import json; print(json.load(open('$CONFIG'))['url'])" 2>/dev/null) \
    || die "Cannot read connection.json"
TOKEN=$(python3 -c "import json; print(json.load(open('$CONFIG'))['token'])" 2>/dev/null) \
    || die "Cannot read token from connection.json"

# Verify the PID is still alive
PID=$(python3 -c "import json; print(json.load(open('$CONFIG'))['pid'])" 2>/dev/null)
if [ -n "$PID" ] && ! kill -0 "$PID" 2>/dev/null; then
    die "Agent Browser (PID $PID) is no longer running. Stale connection descriptor."
fi

# Send a structured protocol request
agent_call() {
    local method="$1"
    shift
    # Build params JSON from remaining args (key=value pairs)
    local params="{"
    local first=true
    for arg in "$@"; do
        local key="${arg%%=*}"
        local val="${arg#*=}"
        if [ "$first" = true ]; then first=false; else params+=","; fi
        params+="\"$key\":\"$val\""
    done
    params+="}"
    if [ "$params" = "{}" ]; then params="null"; fi

    curl -sS -X POST \
        -H "Authorization: Bearer $TOKEN" \
        -H "Content-Type: application/json" \
        -H "Host: ${URL##http://}" \
        -d "{\"version\":1,\"method\":\"$method\",\"params\":$params}" \
        "$URL/agent"
}

# Pretty-print JSON, extracting .result if present
format_result() {
    python3 -c "
import json, sys
try:
    resp = json.load(sys.stdin)
    if not resp.get('ok', True):
        err = resp.get('error', {})
        print(f\"error [{err.get('code','?')}]: {err.get('message','unknown')}\", file=sys.stderr)
        sys.exit(1)
    result = resp.get('result')
    if result is not None:
        print(json.dumps(result, indent=2))
except json.JSONDecodeError:
    sys.stdin.seek(0)
    print(sys.stdin.read())
"
}

# Print just the content field for read
format_read() {
    python3 -c "
import json, sys
try:
    resp = json.load(sys.stdin)
    if not resp.get('ok', True):
        err = resp.get('error', {})
        print(f\"error [{err.get('code','?')}]: {err.get('message','unknown')}\", file=sys.stderr)
        sys.exit(1)
    result = resp.get('result', {})
    content = result.get('content', '')
    fmt = result.get('format', '?')
    et = result.get('extractionTime', 0)
    bl = result.get('byteLength', 0)
    print(content)
    print(f'\n--- [{fmt}, {bl} bytes, {et}s] ---', file=sys.stderr)
except json.JSONDecodeError:
    print('error: invalid response', file=sys.stderr)
    sys.exit(1)
"
}

# Save screenshot from base64 in result
save_screenshot() {
    local output="$1"
    python3 -c "
import json, sys, base64
resp = json.load(sys.stdin)
if not resp.get('ok', True):
    err = resp.get('error', {})
    print(f\"error [{err.get('code','?')}]: {err.get('message','unknown')}\", file=sys.stderr)
    sys.exit(1)
result = resp.get('result', {})
data = base64.b64decode(result.get('data', ''))
with open('$output', 'wb') as f:
    f.write(data)
w, h = result.get('width', 0), result.get('height', 0)
print(f'Saved {len(data)} bytes ({w}x{h}) to $output')
"
}

case "${1:-help}" in
    health)
        curl -sS "$URL/health" | python3 -m json.tool
        ;;

    tabs|list)
        agent_call "tabs.list" | format_result
        ;;

    tab|get)
        [ -n "${2:-}" ] || die "Usage: browser-ctl tab <id>"
        agent_call "tabs.get" "id=$2" | format_result
        ;;

    open)
        [ -n "${2:-}" ] || die "Usage: browser-ctl open <url>"
        agent_call "tabs.open" "url=$2" | format_result
        ;;

    read)
        [ -n "${2:-}" ] || die "Usage: browser-ctl read <id> [--text|--html|--markdown]"
        FORMAT="markdown"
        case "${3:-}" in
            --text) FORMAT="text" ;;
            --html) FORMAT="html" ;;
            --markdown|"") FORMAT="markdown" ;;
            *) die "Unknown format: $3. Use --text, --html, or --markdown" ;;
        esac
        agent_call "page.read" "id=$2" "format=$FORMAT" | format_read
        ;;

    eval|js)
        [ -n "${2:-}" ] && [ -n "${3:-}" ] || die "Usage: browser-ctl eval <id> '<script>'"
        # Use structured protocol with proper JSON escaping
        ESCAPED=$(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$3")
        curl -sS -X POST \
            -H "Authorization: Bearer $TOKEN" \
            -H "Content-Type: application/json" \
            -H "Host: ${URL##http://}" \
            -d "{\"version\":1,\"method\":\"page.eval\",\"params\":{\"id\":\"$2\",\"script\":$ESCAPED}}" \
            "$URL/agent" | format_result
        ;;

    screenshot)
        [ -n "${2:-}" ] || die "Usage: browser-ctl screenshot <id> [output.png]"
        OUTPUT="${3:-screenshot.png}"
        agent_call "page.screenshot" "id=$2" | save_screenshot "$OUTPUT"
        ;;

    help|--help|-h)
        cat <<'EOF'
browser-ctl: Control a running Agent Browser from the terminal.

Commands:
  health                           Check if browser is running
  tabs                             List all open tabs (JSON)
  tab <id>                         Get details for a tab
  open <url>                       Open URL in a new tab
  read <id> [--text|--html]        Read page content (default: markdown)
  eval <id> '<script>'             Execute JavaScript in a tab
  screenshot <id> [file.png]       Save tab screenshot

All responses use the structured protocol:
  {"ok": true, "result": ...}  or  {"ok": false, "error": {"code": "...", "message": "..."}}

Tab IDs are UUIDs. Get them from 'browser-ctl tabs'.
Connection info: ~/.config/agent-browser/connection.json

Examples:
  browser-ctl tabs
  browser-ctl open https://github.com
  browser-ctl read <id>                    # Markdown extraction
  browser-ctl read <id> --text             # Raw innerText
  browser-ctl eval <id> 'return document.title'
  browser-ctl screenshot <id> page.png
EOF
        ;;

    *)
        die "Unknown command: $1. Run 'browser-ctl help' for usage."
        ;;
esac

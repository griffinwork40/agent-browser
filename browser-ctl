#!/bin/bash
# browser-ctl: Control a running Agent Browser from the terminal.
#
# Reads connection info from ~/.config/agent-browser/connection.json
# and communicates with the browser's local HTTP API.
#
# Usage:
#   browser-ctl tabs                             List open tabs
#   browser-ctl tab <id>                         Get tab details
#   browser-ctl open <url>                       Open URL in new tab
#   browser-ctl read <id> [--text|--html]        Read page content (default: markdown)
#   browser-ctl eval <id> <script>               Execute JavaScript
#   browser-ctl screenshot <id> [output.png]     Save screenshot
#   browser-ctl health                           Check browser status
#
# Tab IDs are UUIDs from 'browser-ctl tabs'. Closing a tab invalidates its ID.

set -euo pipefail

CONFIG="$HOME/.config/agent-browser/connection.json"

die() { echo "error: $1" >&2; exit 1; }

[ -f "$CONFIG" ] || die "Agent Browser not running (no $CONFIG)"

URL=$(python3 -c "import json; print(json.load(open('$CONFIG'))['url'])" 2>/dev/null) \
    || die "Cannot read connection.json"
TOKEN=$(python3 -c "import json; print(json.load(open('$CONFIG'))['token'])" 2>/dev/null) \
    || die "Cannot read token from connection.json"

# Verify the PID is still alive
PID=$(python3 -c "import json; print(json.load(open('$CONFIG'))['pid'])" 2>/dev/null)
if [ -n "$PID" ] && ! kill -0 "$PID" 2>/dev/null; then
    die "Agent Browser (PID $PID) is no longer running. Stale connection descriptor."
fi

# Send a structured protocol request
agent_call() {
    local method="$1"
    shift
    # Build params JSON from remaining args (key=value pairs)
    local params="{"
    local first=true
    for arg in "$@"; do
        local key="${arg%%=*}"
        local val="${arg#*=}"
        if [ "$first" = true ]; then first=false; else params+=","; fi
        params+="\"$key\":\"$val\""
    done
    params+="}"
    if [ "$params" = "{}" ]; then params="null"; fi

    curl -sS -X POST \
        -H "Authorization: Bearer $TOKEN" \
        -H "Content-Type: application/json" \
        -H "Host: ${URL##http://}" \
        -d "{\"version\":1,\"method\":\"$method\",\"params\":$params}" \
        "$URL/agent"
}

# Pretty-print JSON, extracting .result if present
format_result() {
    python3 -c "
import json, sys
try:
    resp = json.load(sys.stdin)
    if not resp.get('ok', True):
        err = resp.get('error', {})
        print(f\"error [{err.get('code','?')}]: {err.get('message','unknown')}\", file=sys.stderr)
        sys.exit(1)
    result = resp.get('result')
    if result is not None:
        print(json.dumps(result, indent=2))
except json.JSONDecodeError:
    sys.stdin.seek(0)
    print(sys.stdin.read())
"
}

# Print just the content field for read
format_read() {
    python3 -c "
import json, sys
try:
    resp = json.load(sys.stdin)
    if not resp.get('ok', True):
        err = resp.get('error', {})
        print(f\"error [{err.get('code','?')}]: {err.get('message','unknown')}\", file=sys.stderr)
        sys.exit(1)
    result = resp.get('result', {})
    content = result.get('content', '')
    fmt = result.get('format', '?')
    et = result.get('extractionTime', 0)
    bl = result.get('byteLength', 0)
    print(content)
    print(f'\n--- [{fmt}, {bl} bytes, {et}s] ---', file=sys.stderr)
except json.JSONDecodeError:
    print('error: invalid response', file=sys.stderr)
    sys.exit(1)
"
}

# Save screenshot from base64 in result
save_screenshot() {
    local output="$1"
    python3 -c "
import json, sys, base64
resp = json.load(sys.stdin)
if not resp.get('ok', True):
    err = resp.get('error', {})
    print(f\"error [{err.get('code','?')}]: {err.get('message','unknown')}\", file=sys.stderr)
    sys.exit(1)
result = resp.get('result', {})
data = base64.b64decode(result.get('data', ''))
with open('$output', 'wb') as f:
    f.write(data)
w, h = result.get('width', 0), result.get('height', 0)
print(f'Saved {len(data)} bytes ({w}x{h}) to $output')
"
}

case "${1:-help}" in
    health)
        curl -sS "$URL/health" | python3 -m json.tool
        ;;

    tabs|list)
        agent_call "tabs.list" | format_result
        ;;

    tab|get)
        [ -n "${2:-}" ] || die "Usage: browser-ctl tab <id>"
        agent_call "tabs.get" "id=$2" | format_result
        ;;

    open)
        [ -n "${2:-}" ] || die "Usage: browser-ctl open <url>"
        agent_call "tabs.open" "url=$2" | format_result
        ;;

    read)
        [ -n "${2:-}" ] || die "Usage: browser-ctl read <id> [--text|--html|--markdown]"
        FORMAT="markdown"
        case "${3:-}" in
            --text) FORMAT="text" ;;
            --html) FORMAT="html" ;;
            --markdown|"") FORMAT="markdown" ;;
            *) die "Unknown format: $3. Use --text, --html, or --markdown" ;;
        esac
        agent_call "page.read" "id=$2" "format=$FORMAT" | format_read
        ;;

    eval|js)
        [ -n "${2:-}" ] && [ -n "${3:-}" ] || die "Usage: browser-ctl eval <id> '<script>'"
        # Use structured protocol with proper JSON escaping
        ESCAPED=$(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$3")
        curl -sS -X POST \
            -H "Authorization: Bearer $TOKEN" \
            -H "Content-Type: application/json" \
            -H "Host: ${URL##http://}" \
            -d "{\"version\":1,\"method\":\"page.eval\",\"params\":{\"id\":\"$2\",\"script\":$ESCAPED}}" \
            "$URL/agent" | format_result
        ;;

    screenshot)
        [ -n "${2:-}" ] || die "Usage: browser-ctl screenshot <id> [output.png]"
        OUTPUT="${3:-screenshot.png}"
        agent_call "page.screenshot" "id=$2" | save_screenshot "$OUTPUT"
        ;;

    inspect)
        [ -n "${2:-}" ] || die "Usage: browser-ctl inspect <tab-id>"
        agent_call "page.inspect" "id=$2" | format_result
        ;;

    click)
        [ -n "${2:-}" ] && [ -n "${3:-}" ] || die "Usage: browser-ctl click <tab-id> <element-id>"
        agent_call "page.click" "id=$2" "elementId=$3" | format_result
        ;;

    fill)
        [ -n "${2:-}" ] && [ -n "${3:-}" ] && [ -n "${4:-}" ] || die "Usage: browser-ctl fill <tab-id> <element-id> <value>"
        # Use structured protocol with proper JSON escaping for the value
        ESCAPED_VAL=$(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$4")
        curl -sS -X POST \
            -H "Authorization: Bearer $TOKEN" \
            -H "Content-Type: application/json" \
            -H "Host: ${URL##http://}" \
            -d "{\"version\":1,\"method\":\"page.fill\",\"params\":{\"id\":\"$2\",\"elementId\":\"$3\",\"value\":$ESCAPED_VAL}}" \
            "$URL/agent" | format_result
        ;;

    press)
        [ -n "${2:-}" ] && [ -n "${3:-}" ] || die "Usage: browser-ctl press <tab-id> <key> [element-id]"
        if [ -n "${4:-}" ]; then
            agent_call "page.press" "id=$2" "key=$3" "elementId=$4" | format_result
        else
            agent_call "page.press" "id=$2" "key=$3" | format_result
        fi
        ;;

    select)
        [ -n "${2:-}" ] && [ -n "${3:-}" ] && [ -n "${4:-}" ] || die "Usage: browser-ctl select <tab-id> <element-id> <value>"
        agent_call "page.select" "id=$2" "elementId=$3" "value=$4" | format_result
        ;;

    wait)
        [ -n "${2:-}" ] || die "Usage: browser-ctl wait <tab-id> [--url <pattern>|--text <text>|--element <selector>|--load] [--timeout <secs>]"
        TAB_ID="$2"
        CONDITION="load"
        WAIT_VALUE=""
        TIMEOUT="10"
        shift 2
        while [ $# -gt 0 ]; do
            case "$1" in
                --url) CONDITION="url"; WAIT_VALUE="${2:-}"; shift 2 ;;
                --text) CONDITION="text"; WAIT_VALUE="${2:-}"; shift 2 ;;
                --element) CONDITION="element"; WAIT_VALUE="${2:-}"; shift 2 ;;
                --load) CONDITION="load"; shift ;;
                --timeout) TIMEOUT="${2:-10}"; shift 2 ;;
                *) die "Unknown wait option: $1" ;;
            esac
        done
        ESCAPED_VAL=$(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$WAIT_VALUE")
        curl -sS -X POST \
            -H "Authorization: Bearer $TOKEN" \
            -H "Content-Type: application/json" \
            -H "Host: ${URL##http://}" \
            -d "{\"version\":1,\"method\":\"page.wait\",\"params\":{\"id\":\"$TAB_ID\",\"condition\":\"$CONDITION\",\"value\":$ESCAPED_VAL,\"timeout\":$TIMEOUT}}" \
            "$URL/agent" | format_result
        ;;

    help|--help|-h)
        cat <<'EOF'
browser-ctl: Control a running Agent Browser from the terminal.

Commands:
  health                                    Check if browser is running
  tabs                                      List all open tabs (JSON)
  tab <id>                                  Get details for a tab
  open <url>                                Open URL in new tab
  read <id> [--text|--html]                 Read page content (default: markdown)
  eval <id> '<script>'                      Execute JavaScript in a tab
  screenshot <id> [file.png]                Save tab screenshot

  inspect <id>                              Inspect interactive elements
  click <id> <element-id>                   Click an element
  fill <id> <element-id> <value>            Fill a text input
  press <id> <key> [element-id]             Press a key (Enter, Escape, Tab, etc.)
  select <id> <element-id> <value>          Select option in dropdown
  wait <id> [--url P|--text T|--element S]  Wait for condition (default: --load)
       [--timeout <secs>]                   (timeout default: 10s)

Workflow example:
  ID=$(browser-ctl open https://github.com | python3 -c "import json,sys; print(json.load(sys.stdin)['id'])")
  browser-ctl wait $ID --load
  browser-ctl inspect $ID
  # Find search field: el_abc123  role=textbox  name="Search"
  browser-ctl fill $ID el_abc123 "WKWebView Swift"
  browser-ctl press $ID Enter el_abc123
  browser-ctl wait $ID --url "search"
  browser-ctl read $ID

Element IDs (el_XXXXXX) come from 'inspect' and are valid until the next inspect.
Tab IDs are UUIDs from 'tabs'. Connection: ~/.config/agent-browser/connection.json
EOF
        ;;

    *)
        die "Unknown command: $1. Run 'browser-ctl help' for usage."
        ;;
esac
